diff -ruN a/gamepad_presets/playstation.cfg b/gamepad_presets/playstation.cfg
--- a/gamepad_presets/playstation.cfg	2026-11-13 06:35:34.000000000 +0300
+++ b/gamepad_presets/playstation.cfg	2026-11-15 13:29:04.302681898 +0300
@@ -10,6 +10,8 @@
 bind "Y_BUTTON" "+reload"
 
 // bumpers
+bind "L1_BUTTON" "invprev"
+bind "R1_BUTTON" "invnext"
 
 // triggers
 bind "LTRIGGER" "+attack2"
@@ -17,10 +19,15 @@
 
 // back paddles on DualSense Edge and some third party controllers. SDL orders them right hand first,
 // so PADDLE1 is upper right, PADDLE2 is upper left, PADDLE3 is lower right and PADDLE4 is lower left
+bind "PADDLE1" "savequick"
 bind "PADDLE2" "+jump"
+bind "PADDLE3" "loadquick"
 bind "PADDLE4" "+duck"
 
 // dpad
+bind "DPAD_UP" "invprev"
+bind "DPAD_DOWN" "invnext"
+bind "DPAD_LEFT" "savequick"
 bind "DPAD_RIGHT" "lastinv"
 
 // joysticks clicks
diff -ruN a/gamepad_presets/psp.cfg b/gamepad_presets/psp.cfg
--- a/gamepad_presets/psp.cfg	2026-11-13 06:35:34.000000000 +0300
+++ b/gamepad_presets/psp.cfg	1970-01-01 02:00:00.000000000 +0200
@@ -1,26 +0,0 @@
-// Gamepad layout for PSP, follows Crow-bar's PSP port build 2603.
-// The only analog stick is used to look around, so Triangle and Cross move instead.
-// Buttons are named after their Xbox positions: A is Cross, B is Circle, X is Square and Y is Triangle
-joy_unbindall
-
-// face buttons
-bind "A_BUTTON" "+back"
-bind "B_BUTTON" "impulse 100"
-bind "X_BUTTON" "+use"
-bind "Y_BUTTON" "+forward"
-
-// L and R
-bind "L1_BUTTON" "+jump"
-bind "R1_BUTTON" "+attack"
-
-// dpad
-bind "DPAD_UP" "+attack2"
-bind "DPAD_DOWN" "+duck"
-
-// SELECT
-bind "MODE" "toggleconsole"
-bind "START" "escape"
-
-joy_axis_binding "sfpyrl"
-joy_touchpad_right_mode off
-joy_touchpad_left_mode off
